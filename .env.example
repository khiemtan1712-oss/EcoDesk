# EcoDesk Studio - Environment Variables Example
# Copy this file to `.env` at the project root (never commit `.env` to Git) and fill in real credentials.

# Gemini Assistant API (optional for AI chat assistant)
GEMINI_API_KEY=

# ==============================================================================
# Server-side Email / SMTP Configuration for Registration & Password Reset OTP
# ==============================================================================
# Read exclusively on the server side (`ecodesk-api`) via environment variables / `.env`.
# Works with both `docker compose up -d --build ecodesk-backend` and local `npm run backend`.
# NEVER place API keys / SMTP passwords in frontend JS/HTML, logs, or commit `.env` to Git.
#
# Recommended Provider: Resend SMTP (https://resend.com/docs/send-with-smtp)
#   1. Add and verify your custom sending domain in Resend Dashboard -> Domains (DKIM / SPF DNS records).
#   2. Create an API key with "Sending access" in Resend Dashboard -> API Keys (starts with `re_`).
#   3. Fill in `.env` using Resend official SMTP settings:
#        SMTP_HOST=smtp.resend.com
#        SMTP_PORT=465
#        SMTP_USERNAME=resend
#        SMTP_PASSWORD=re_your_resend_api_key_here
#        MAIL_FROM=no-reply@your-verified-domain.com
#        MAIL_FROM_NAME=EcoDesk Studio
#
#   Port / TLS options supported by Resend:
#     - Port 465 (or 2465): Implicit TLS/SSL (SMTPS - Recommended, backend auto-enables SSL on 465/2465)
#     - Port 587 (or 2587): Explicit TLS (STARTTLS, backend auto-enables STARTTLS on 587/2587)
#   Important: `SMTP_USERNAME` must be literally `resend`. `MAIL_FROM` MUST be an email address
#   on a domain you verified in Resend (unverified domains or mismatched senders are rejected).
#
# Optional alternative (Gmail / standard SMTP):
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=you@gmail.com, SMTP_PASSWORD=<16-char App Password>, MAIL_FROM=you@gmail.com

SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=EcoDesk Studio

# Optional explicit TLS overrides (auto-resolved from port 465/2465 vs 587/2587 when left at defaults)
SMTP_AUTH=true
SMTP_STARTTLS=false
SMTP_SSL=true

# Optional backend port (must match Vite `/api` proxy if changed from default 8080)
# Note: Use only ONE backend mode at a time on port 8080:
#   - Docker mode: `docker compose up -d ecodesk-backend` (recreate container after editing `.env`)
#   - Local Maven mode: `docker compose stop ecodesk-backend && npm run docker:db && npm run backend`
SERVER_PORT=8080

# Optional secret pepper used to HMAC/SHA-256 hash OTP codes stored in MySQL (`otp_challenges`).
# Recommended in production: set a long random hex/alphanumeric string.
OTP_SECRET=

# ==============================================================================
# SePay API Access & Direct Bank Transfer QR Configuration
# ==============================================================================
# Docs: https://docs.sepay.vn/tao-api-token.html & https://docs.sepay.vn/api-giao-dich.html
# Read strictly by Spring Boot backend (`ecodesk-api`). NEVER expose SEPAY_API_TOKEN to frontend.
#
# Environment isolation:
#   - live:    uses https://userapi.sepay.vn/v2/transactions (or my.sepay.vn for v1)
#   - sandbox: uses https://userapi-sandbox.sepay.vn/v2/transactions (Test Mode token ONLY)
SEPAY_ENVIRONMENT=live
SEPAY_API_VERSION=v2
SEPAY_API_TOKEN=

# Receiving bank account details displayed on VietQR / SePay QR & matched against incoming transfers
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=

# Must match the active Payment Code prefix configured in SePay Dashboard (default: DH)
SEPAY_PAYMENT_PREFIX=DH

# Scheduled backend sync interval in milliseconds (minimum enforced: 5000ms; respects HTTP 429 Retry-After)
SEPAY_SYNC_ENABLED=true
SEPAY_SYNC_INTERVAL_MS=15000
SEPAY_SYNC_LOOKBACK_DAYS=1
